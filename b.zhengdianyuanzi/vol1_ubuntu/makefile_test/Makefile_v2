#define variables
CC = gcc
objs = main.o calculate.o get_input.o
Q=@

main: $(objs)
	$(Q)echo "compiling"
	$(Q)$(CC) -o main $(objs)


main.o:main.c
	$(Q)$(CC) -c main.c

calculate.o:calculate.c
	$(Q)$(CC) -c calculate.c

get_input.o:get_input.c
	$(Q)$(CC) -c get_input.c


clean:
	$(Q)echo "cleaning"
	$(Q)rm -f $(objs)
	$(Q)rm -f main


